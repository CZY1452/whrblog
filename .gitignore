# ============================================================
#  WhrBlog 项目 .gitignore
# ============================================================

# -------------------- Python --------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
*.egg
build/
dist/
.venv/
venv/
env/
ENV/

# -------------------- Django 运行时产物 --------------------
# 日志
logs/
*.log

# 用户上传文件（media，运行时通过 volume 挂载）
uploads/

# collectstatic 产物
collectedstatic/

# 本地数据库
*.sqlite3
db.sqlite3

# -------------------- 环境变量（含密钥，严禁提交） --------------------
# 真实环境变量文件；根目录 .env.prod 是生产模板（含随机密码），亦不提交
.env
.env.prod
.env.local
.env.*.local

# -------------------- 测试与覆盖率 --------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# -------------------- IDE / 编辑器 / 系统 --------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# -------------------- Node / 前端 --------------------
node_modules/
frontend/node_modules/
frontend/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------- WorkBuddy 工作记忆 --------------------
# 本地项目工作日志/记忆，不属于项目源码
.workbuddy/

# -------------------- 其他 --------------------
*.bak
*.tmp
