# ================================================================
#  WhrBlog 生产环境变量模板（纯 HTTP，IP 直访，无需域名 / 证书）
#  用法：
#    1. 复制为仓库根目录下的 .env：cp deploy/.env.prod .env
#       （.env 已被 .gitignore 忽略，不会误提交真实密钥）
#    2. 按需修改下方【必改】项（SECRET_KEY / 各类密码 / 服务器 IP）
#    3. docker compose up -d
#  说明：本模板对应「公网 IP 直访 + 纯 HTTP」部署，不做 HTTPS。
# ================================================================

# ================================================================
#  一、Django 基础与安全配置
# ================================================================
# 【必改】生产随机密钥：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME_generate_random_secret_key

# 生产必须为 False
DJANGO_DEBUG=False

# 【必改】允许访问的主机：填服务器公网 IP（逗号分隔，可保留 127.0.0.1,localhost）
DJANGO_ALLOWED_HOSTS=47.113.150.22,127.0.0.1,localhost

# CSRF 信任来源：纯 HTTP，前缀必须为 http://
DJANGO_CSRF_TRUSTED_ORIGINS=http://47.113.150.22

DJANGO_LANGUAGE_CODE=zh-hans
DJANGO_TIME_ZONE=Asia/Shanghai
DJANGO_USE_TZ=False
SITE_ID=1
DJANGO_LOG_LEVEL=INFO

# 纯 HTTP 部署：务必为 False，否则 SESSION / CSRF Cookie 被标记为 Secure，导致登录与表单提交失败
DJANGO_SECURE_SSL=False

# ================================================================
#  二、MySQL 数据库配置（容器内部网络）
# ================================================================
DJANGO_MYSQL_DATABASE=whrblog
DJANGO_MYSQL_USER=whr
# 【必改】数据库密码
DJANGO_MYSQL_PASSWORD=CHANGE_ME_mysql_password
DJANGO_MYSQL_HOST=mysql
DJANGO_MYSQL_PORT=3306

# ================================================================
#  三、Redis 缓存配置
# ================================================================
# 【必改】Redis 密码
REDIS_PASSWORD=CHANGE_ME_redis_password
DJANGO_REDIS_URL=:CHANGE_ME_redis_password@redis:6379/0

# ================================================================
#  四、邮箱发送配置（SMTP）
#  说明：仅邮件发送需要真实值；CHANGE_ME 不影响站点启动
# ================================================================
DJANGO_EMAIL_HOST=smtp.qq.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_SSL=False
DJANGO_EMAIL_TLS=True
DJANGO_EMAIL_USER=CHANGE_ME_email@example.com
DJANGO_EMAIL_PASSWORD=CHANGE_ME_email_auth_code
DJANGO_ADMIN_EMAIL=CHANGE_ME_email@example.com

# ================================================================
#  五、前端构建（Vite）
# ================================================================
# 生产由 Nginx 托管构建产物，此项填服务器 IP 即可
VITE_DEV_SERVER_URL=http://47.113.150.22

# ================================================================
#  六、静态资源压缩（django-compressor）
# ================================================================
COMPRESS_OFFLINE=True

# ================================================================
#  七、分页与会话配置
# ================================================================
SESSION_COOKIE_AGE=1209600
REMEMBER_ME_LOGIN_TTL=2626560

# ================================================================
#  八、Elasticsearch 配置（容器内部，明文 HTTP）
# ================================================================
ES_HOST=http://elasticsearch:9200
# 【必改】ES elastic 用户密码
ES_PASSWORD=CHANGE_ME_es_password
ES_INDEX=whrblog
ES_VERIFY_CERTS=False
