# ============================================================
#  WhrBlog 生产环境变量模板
#  复制本文件为 .env 并修改所有占位符后再启动
#  cp .env.prod .env
# ============================================================


# ================================================================
#  一、Django 基础与安全配置
# ================================================================

# 【必填】项目安全密钥（务必更换为随机长字符串）
# 生成命令：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# 【必填】调试模式（生产必须为 False）
DJANGO_DEBUG=False

# 【必填】允许访问的域名，逗号分隔（你的实际域名）
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# 【必填】CSRF 信任来源（必须包含 https 协议）
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# 站点语言
DJANGO_LANGUAGE_CODE=zh-hans

# 时区
DJANGO_TIME_ZONE=Asia/Shanghai

# 生产环境建议开启时区
DJANGO_USE_TZ=True

# Django 站点 ID
SITE_ID=1

# 日志级别
DJANGO_LOG_LEVEL=INFO

# 是否启用 HTTPS（影响安全 Cookie 设置，启用 HTTPS 后设为 True）
DJANGO_SECURE_SSL=True


# ================================================================
#  二、MySQL 数据库配置
# ================================================================

# 【Docker】数据库主机（Docker 网络中使用服务名）
DJANGO_MYSQL_HOST=mysql

# 数据库端口
DJANGO_MYSQL_PORT=3306

# 数据库名称
DJANGO_MYSQL_DATABASE=whrblog

# 【必填】数据库用户名
DJANGO_MYSQL_USER=whr

# 【必填】数据库密码（务必修改为强密码）
DJANGO_MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD


# ================================================================
#  三、Redis 缓存配置
# ================================================================

# 【必填】Redis 密码（docker-compose 中也会读取此变量）
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Redis 连接（密码需与上面的 REDIS_PASSWORD 一致，Docker 网络中使用服务名 redis）
DJANGO_REDIS_URL=:CHANGE_ME_REDIS_PASSWORD@redis:6379/0


# ================================================================
#  四、邮箱发送配置（SMTP）
# ================================================================

# SMTP 服务器地址
DJANGO_EMAIL_HOST=smtp.qq.com

# SMTP 端口（SSL=465，TLS=587）
DJANGO_EMAIL_PORT=465

# SSL/TLS（二选一）
DJANGO_EMAIL_SSL=True
DJANGO_EMAIL_TLS=False

# 发件邮箱账号
DJANGO_EMAIL_USER=your-email@qq.com

# 发件邮箱密码或授权码
DJANGO_EMAIL_PASSWORD=CHANGE_ME_EMAIL_AUTH_CODE

# 管理员邮箱（接收系统错误通知）
DJANGO_ADMIN_EMAIL=admin@yourdomain.com


# ================================================================
#  五、Elasticsearch 配置
# ================================================================

# 【Docker】ES 地址（Docker 网络中使用服务名；ES 9 启用安全后为 https）
ES_HOST=https://elasticsearch:9200

# ES 用户名
ES_USER=elastic

# 【必填】ES 密码（务必修改；与 docker-compose 中 ELASTIC_PASSWORD 保持一致）
ES_PASSWORD=CHANGE_ME_ES_PASSWORD

# ES 索引名
ES_INDEX=whrblog

# ES 使用自签名证书，客户端不验证证书（内网）
ES_VERIFY_CERTS=False


# ================================================================
#  六、静态资源压缩
# ================================================================

# 生产环境必须开启离线压缩
COMPRESS_OFFLINE=True


# ================================================================
#  七、分页与会话
# ================================================================

PAGINATE_BY=10
SESSION_COOKIE_AGE=1209600
REMEMBER_ME_LOGIN_TTL=2626560


# ================================================================
#  八、Gunicorn 配置
# ================================================================

# Worker 数量（默认 CPU 核数 * 2 + 1，2核机器设为 5）
GUNICORN_WORKERS=5

# 日志级别
GUNICORN_LOG_LEVEL=info
