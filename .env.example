# ================================================================
#  WhrBlog 开发环境变量示例（可安全提交到版本库）
#  用法：cp .env.example .env  然后 docker compose up -d
#  说明：
#   1. 本文件包含「纯 Docker 开发默认值」，克隆到任意机器后
#      cp .env.example .env && docker compose up -d 即可直接跑起来
#   2. MySQL/Redis/Elasticsearch 均指向 Docker 服务名
#      （mysql / redis / elasticsearch），走容器内部网络 whrblog-net
#   3. ⚠️ 仅限本地开发：DEBUG=True / ALLOWED_HOSTS=* / 写死 SECRET_KEY 切勿用于生产
#      （生产请参考 deploy/.env.prod 模板，改为 False / 限定域名 / 随机 SECRET_KEY）
#   4. 修改后需重启服务才能生效
# ================================================================


# ================================================================
#  一、Django 基础与安全配置
# ================================================================

# 项目安全密钥（生产环境务必更换为随机长字符串）
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-dev-only-not-for-prod-whrblog-9f8e7d6c5b4a3210

# 调试模式（开发=True，生产必须为 False）
DJANGO_DEBUG=True

# 允许访问的主机名列表，逗号分隔
# 值为 * 表示允许所有主机（仅限开发环境使用）
DJANGO_ALLOWED_HOSTS=*,127.0.0.1,localhost

# CSRF 信任的来源域名列表，逗号分隔
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# 站点语言代码（zh-hans=简体中文）
DJANGO_LANGUAGE_CODE=zh-hans

# 时区
DJANGO_TIME_ZONE=Asia/Shanghai

# 是否使用带时区的时间（生产环境建议 True）
DJANGO_USE_TZ=False

# Django 站点 ID
SITE_ID=1

# 日志输出级别
DJANGO_LOG_LEVEL=INFO


# ================================================================
#  二、MySQL 数据库配置（Docker 服务名，容器内部网络）
# ================================================================

# 数据库名称
DJANGO_MYSQL_DATABASE=whrblog

# 数据库用户名（compose 默认创建 whr 用户）
DJANGO_MYSQL_USER=whr

# 数据库密码（compose 必填项，开发默认值）
DJANGO_MYSQL_PASSWORD=123456

# 数据库主机地址（Docker 服务名）
DJANGO_MYSQL_HOST=mysql

# 数据库端口（容器内 3306）
DJANGO_MYSQL_PORT=3306


# ================================================================
#  三、Redis 缓存配置（Docker 服务名）
# ================================================================

# Redis 访问密码（compose 必填项，供 redis / backend / worker 使用）
REDIS_PASSWORD=whr1452

# Redis 连接 URL（容器内由 compose 强制覆盖为 redis 服务名）
DJANGO_REDIS_URL=:whr1452@redis:6379/0


# ================================================================
#  四、邮箱发送配置（SMTP）
#  注意：仅邮件发送功能需要真实值；留 CHANGE_ME 不影响站点启动
# ================================================================

# SMTP 服务器地址
DJANGO_EMAIL_HOST=smtp.qq.com

# SMTP 服务器端口
DJANGO_EMAIL_PORT=587

# 是否使用 SSL 加密
DJANGO_EMAIL_SSL=False

# 是否使用 TLS 加密
DJANGO_EMAIL_TLS=True

# 发件邮箱账号
DJANGO_EMAIL_USER=1772028859@qq.com

# 发件邮箱密码或授权码（CHANGE_ME 时邮件发送会失败，但站点可正常运行）
DJANGO_EMAIL_PASSWORD=CHANGE_ME

# 管理员邮箱
DJANGO_ADMIN_EMAIL=1772028859@qq.com


# ================================================================
#  五、前端构建（Vite）
# ================================================================

# Vite 开发服务器地址（仅开发模式使用）
VITE_DEV_SERVER_URL=http://localhost:5173


# ================================================================
#  六、静态资源压缩（django-compressor）
# ================================================================

# 是否启用离线压缩
COMPRESS_OFFLINE=False


# ================================================================
#  七、分页与会话配置
# ================================================================

# 每页显示的文章数量
PAGINATE_BY=10

# 会话 Cookie 有效期（秒）
SESSION_COOKIE_AGE=1209600

# "记住我"登录有效期（秒）
REMEMBER_ME_LOGIN_TTL=2626560


# ================================================================
#  八、Elasticsearch 配置（Docker 服务名，明文 HTTP）
# ================================================================

# ES 地址（容器内部走 Docker 服务名，明文 HTTP 非 HTTPS）
ES_HOST=http://elasticsearch:9200

# ES elastic 用户密码（compose 必填项，开发默认值）
ES_PASSWORD=whr1452

# ES 索引名
ES_INDEX=whrblog

# 是否校验证书（明文 HTTP 时关闭）
ES_VERIFY_CERTS=False
