# ================================================================
#  WhrBlog 开发环境变量示例（可安全提交到版本库）
#  用法：cp .env.example .env  然后 docker compose up -d
#  说明：
#   1. 本文件包含「纯 Docker 开发默认值」，克隆到任意机器后
#      cp .env.example .env && docker compose up -d 即可直接跑起来
#   2. MySQL/Redis/Elasticsearch 均指向 Docker 服务名
#      （mysql / redis / elasticsearch），走容器内部网络 whrblog-net
#   3. ⚠️ 仅限本地开发：DEBUG=True / ALLOWED_HOSTS=* / 写死 SECRET_KEY 切勿用于生产
#      （生产请参考 deploy/.env.prod 模板，改为 False / 限定公网 IP / 随机 SECRET_KEY）
#   4. 修改后需重启服务才能生效
# ================================================================

# ================================================================
#  一、Django 基础与安全配置
# ================================================================
DJANGO_SECRET_KEY=CRm1x0PJrtsmBHDSmZvS2wvE3XlQEq4ECO2PlPMqxwkAHWBg3UmEihR1LodWQ40CeFaA5ad0Et95e4fxxaYopQ

# 调试模式开发=True
DJANGO_DEBUG=True

# 【必改】允许访问的主机：填服务器公网 IP（逗号分隔，可保留 127.0.0.1,localhost）
DJANGO_ALLOWED_HOSTS=YOUR_SERVER_IP,127.0.0.1,localhost

# CSRF 信任来源：纯 HTTP，前缀必须为 http://
DJANGO_CSRF_TRUSTED_ORIGINS=http://YOUR_SERVER_IP

DJANGO_LANGUAGE_CODE=zh-hans
DJANGO_TIME_ZONE=Asia/Shanghai
DJANGO_USE_TZ=False
SITE_ID=1
DJANGO_LOG_LEVEL=INFO

# 纯 HTTP 部署：务必为 False，否则 SESSION / CSRF Cookie 被标记为 Secure，导致登录与表单提交失败
DJANGO_SECURE_SSL=False

# ================================================================
#  二、MySQL 数据库配置（容器内部网络）
# ================================================================
DJANGO_MYSQL_DATABASE=whrblog
DJANGO_MYSQL_USER=whr
# 随机生成，无需修改
DJANGO_MYSQL_PASSWORD=r9KqPKrVWxdzLPi81otk
DJANGO_MYSQL_HOST=mysql
DJANGO_MYSQL_PORT=3306

# ================================================================
#  三、Redis 缓存配置
# ================================================================
# 随机生成，无需修改
REDIS_PASSWORD=UYcLaZeEHFqUx9i6p7ln
DJANGO_REDIS_URL=:UYcLaZeEHFqUx9i6p7ln@redis:6379/0

# ================================================================
#  四、邮箱发送配置（SMTP）
#  说明：仅邮件发送需要真实值；保持现状不影响站点启动
# ================================================================
# SMTP 服务器地址
DJANGO_EMAIL_HOST=smtp.qq.com
# SMTP 服务器端口
DJANGO_EMAIL_PORT=587
# 是否使用 SSL 加密
DJANGO_EMAIL_SSL=False
# 是否使用 TLS 加密
DJANGO_EMAIL_TLS=True
# 发件邮箱账号
DJANGO_EMAIL_USER=
# 发件邮箱密码或授权码（CHANGE_ME 时邮件发送会失败，但站点可正常运行）
DJANGO_EMAIL_PASSWORD=
# 管理员邮箱
DJANGO_ADMIN_EMAIL=
# ================================================================
#  五、前端构建（Vite）
# ================================================================
# 生产由 Nginx 托管构建产物，此项填服务器 IP 即可
VITE_DEV_SERVER_URL=http://YOUR_SERVER_IP

# ================================================================
#  六、静态资源压缩（django-compressor）
# ================================================================
COMPRESS_OFFLINE=True

# ================================================================
#  七、分页与会话配置
# ================================================================
SESSION_COOKIE_AGE=1209600
REMEMBER_ME_LOGIN_TTL=2626560

# ================================================================
#  八、Elasticsearch 配置（容器内部，明文 HTTP）
# ================================================================
ES_HOST=http://elasticsearch:9200
# 随机生成，无需修改
ES_PASSWORD=mabKJ5NqcyjBwHaly4Hr
ES_INDEX=whrblog
ES_VERIFY_CERTS=False
